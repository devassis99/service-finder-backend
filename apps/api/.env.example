NODE_ENV=development
# 4000, not 3000: iGroom's API holds 3000 on the same machine.
PORT=4000
# Valkey (or Redis) for the sign-in attempt limits. `docker compose up -d`
# starts one on localhost:6380. In AWS this is ElastiCache Serverless for
# Valkey: rediss://<endpoint>:6379 with REDIS_CLUSTER=true. Blank turns the
# limits off (they fail open) — fine locally, warned about in production.
REDIS_URL=redis://localhost:6380
REDIS_CLUSTER=false

# How many proxies sit in front of this server: 1 behind the ALB alone, 2
# with CloudFront in front of it. Required in production (the server won't
# start without it): per-device limits key on the caller's IP, and with 0
# every caller looks like the load balancer.
TRUST_PROXY_HOPS=0
# Pin the process clock to UTC. Every absolute-time column is timestamptz
# (see packages/db/src/schema/_helpers.ts), so storage is already
# zone-proof — this is for the remaining places a bare Date is parsed or
# formatted, and so logs from every machine read the same. Set it in your
# deploy env too.
TZ=UTC
# docker compose's Postgres, on 5433 (5432 is iGroom's).
DATABASE_URL=postgresql://user:password@localhost:5433/service_finder
# Direct (non-pooled) connection used by drizzle-kit and migrations.
# Once PgBouncer is in front, point DATABASE_URL at PgBouncer's port
# (e.g. 6432) and keep this one pointed straight at Postgres.
# Leave unset while there's no PgBouncer yet — it'll fall back to DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5433/service_finder
# Optional, comma-separated read replica connection strings.
# Leave empty in local/dev — reads just fall back to the primary.
DATABASE_REPLICA_URLS=

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# ID (Web application type). The back office and the business app use
# this same client ID to get a Google ID token; the backend verifies it was
# issued for this client. Add http://localhost:5273 and
# http://localhost:5274 to the client's Authorised JavaScript origins (or
# reuse iGroom's client and add the origins there).
GOOGLE_CLIENT_ID=

# Signs/verifies access tokens and short-lived MFA-flow tokens.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Encrypts TOTP MFA secrets at rest. Generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=

# Stripe Dashboard → Developers → API keys. Use a test-mode key
# (sk_test_...) until you're ready to go live (sk_live_...). Required: the
# Plans page creates every product, price and payment link in Stripe first.
# A separate Stripe account (or at least sandbox) from iGroom's keeps the
# two apps' products apart in the Dashboard.
STRIPE_SECRET_KEY=

# Base URL of the business app (service-finder-frontend-tenant). Staff
# invite emails link to <this>/invite#<token>, and the Plans page's
# per-price "Copy" hands out <this>/join/<token> signup links. Defaults to
# its local Vite dev server if unset.
TENANT_APP_URL=http://localhost:5274

# Only read by `pnpm db:seed`, not by the running app — the email of the
# person to pre-provision as the initial super admin. They claim this
# account by signing in with this exact Google account once, and are
# immediately walked into MFA setup.
SEED_SUPERADMIN_EMAIL=

# Comma-separated list of origins allowed to call this API from a browser.
# Defaults to the two local Vite dev servers — the back office (:5273) and
# the business app (:5274) — if unset. Override this in every non-local
# environment, listing both apps' origins.
CORS_ORIGINS=http://localhost:5273,http://localhost:5274

# Resend (https://resend.com/api-keys) — transactional email through
# src/shared/email.ts. Leave RESEND_API_KEY unset to just log emails to the
# server console instead — enough to develop against without an account.
RESEND_API_KEY=
# Resend refuses to send from a domain you haven't verified. The default is
# Resend's shared testing sender, which needs no domain but only delivers
# to the address the Resend account was created with. Once Service
# Finder's domain is verified at https://resend.com/domains, switch to e.g.
#   RESEND_FROM_EMAIL=Service Finder <no-reply@your-domain>
RESEND_FROM_EMAIL=Service Finder <onboarding@resend.dev>
# With no RESEND_API_KEY, emails are logged rather than sent, and only the
# recipient and subject are printed. Set this to 1 to print the full HTML
# body too — worth it while editing a template, noise otherwise.
EMAIL_DEBUG_HTML=
