{
  "name": "@service-finder/auth",
  "version": "1.0.0",
  "private": true,
  "description": "What every Service Finder access token looks like — the back office today, provider and customer apps later — so the services that issue and check them can't disagree.",
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/*.tsbuildinfo"
  ],
  "type": "commonjs",
  "exports": {
    ".": {
      "service-finder-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jsonwebtoken": "catalog:"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
