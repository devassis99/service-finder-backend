{
  "name": "@service-finder/db",
  "version": "1.0.0",
  "private": true,
  "description": "Service Finder's Postgres schema, its migrations, and the connection pools every app uses.",
  "license": "MIT",
  "files": [
    "dist",
    "drizzle",
    "!dist/**/*.test.*",
    "!dist/*.tsbuildinfo"
  ],
  "type": "commonjs",
  "exports": {
    ".": {
      "service-finder-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "service-finder-source": "./src/schema/index.ts",
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
