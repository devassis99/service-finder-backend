{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "promise", "node"],
  "env": {
    "node": true,
    "es2022": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "style": "off"
  },
  "rules": {
    "import/no-cycle": "error",
    "import/no-unassigned-import": "off"
  },
  "ignorePatterns": ["dist/", "node_modules/"]
}
